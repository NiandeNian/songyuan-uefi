[Defines]
  INF_VERSION = 0x00010005
  BASE_NAME = SongyuanPlatformSecLib
  FILE_GUID = 41DE29DC-0195-4C8D-B62F-6B45A8D82D21
  MODULE_TYPE = SEC
  VERSION_STRING = 1.0
  LIBRARY_CLASS = PlatformSecLib

[Sources]
  PlatformSec.c
  ScreenLog.c

[Sources.AArch64]
  AArch64/PlatformHelper.S

[Packages]
  ArmPkg/ArmPkg.dec
  ArmPlatformPkg/ArmPlatformPkg.dec
  MdePkg/MdePkg.dec
  SiliciumPkg/SiliciumPkg.dec
  QcomPkg/QcomPkg.dec

[BuildOptions]
  *_*_AARCH64_CC_FLAGS = -mgeneral-regs-only -mstrict-align

[FixedPcd]
  gArmPlatformTokenSpaceGuid.PcdCPUCoresStackBase
  gArmPlatformTokenSpaceGuid.PcdCPUCorePrimaryStackSize
